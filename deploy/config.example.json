{
  "elevation": {
    "chain": [
      {"name": "3dep", "type": "arcgis_image",
       "url": "https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer",
       "units": "m", "timeout_s": 20},
      {"name": "opentopodata", "type": "opentopodata",
       "url": "https://api.opentopodata.org/v1", "datasets": "ned10m,srtm30m",
       "batch": 100, "min_interval_s": 1.0},
      {"name": "local", "type": "local_hgt", "path": "/var/lib/fresnelkml/hgt"},
      {"name": "mesh-otd", "type": "opentopodata", "url": "http://10.0.0.5:5000/v1",
       "datasets": "srtm30m", "batch": 500, "min_interval_s": 0}
    ],
    "timeout_s": 10,
    "retries": 2
  },
  "cache": {
    "dir": "/var/cache/fresnelkml",
    "max_mb": 1024,
    "types": {"local_hgt": 0},
    "services": {"3dep": 2048, "dogami": 4096}
  },
  "surface": {
    "sources": [
      {"name": "dogami", "label": "Oregon DOGAMI lidar",
       "url": "https://gis.dogami.oregon.gov/arcgis/rest/services/lidar/DIGITAL_SURFACE_MODEL_MOSAIC/ImageServer",
       "units": "ftUS", "bbox": [-124.8, 41.9, -116.4, 46.4]}
    ],
    "spacing_m": 3,
    "max_points": 25000,
    "threads": 6,
    "timeout_s": 20,
    "time_budget_s": 30
  },
  "map": {
    "tile_servers": [
      {"name": "OpenStreetMap", "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
       "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
       "max_zoom": 19, "cache_mb": 1024},
      {"name": "OpenTopoMap", "url": "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
       "attribution": "&copy; OpenStreetMap contributors, SRTM | style &copy; OpenTopoMap (CC-BY-SA)",
       "max_zoom": 17, "cache_mb": 512},
      {"name": "AREDN K1RKS", "url": "//k1rks-tileserver-world.local.mesh/hot/{z}/{x}/{y}.png",
       "attribution": "&copy; OpenStreetMap contributors", "max_zoom": 19}
    ],
    "default": "OpenStreetMap"
  },
  "nodes": {
    "feeds": [
      {"name": "K1RKS MeshMap", "base": "https://meshmap.k1rks.me/meshmap/data/"}
    ],
    "cache_ttl_s": 60,
    "stale_after_s": 3600
  }
}
