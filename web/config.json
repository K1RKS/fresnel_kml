{
  "elevation": {
    "chain": [
      {"name": "3dep", "type": "arcgis_image",
       "url": "https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer",
       "units": "m", "timeout_s": 20},
      {"name": "opentopodata", "type": "opentopodata",
       "url": "https://api.opentopodata.org/v1", "datasets": "ned10m,srtm30m",
       "batch": 100, "min_interval_s": 0, "retries": 0},
      {"name": "open-meteo", "type": "open-meteo",
       "url": "https://api.open-meteo.com/v1/elevation", "batch": 100},
      {"name": "open-elevation", "type": "open-elevation",
       "url": "https://api.open-elevation.com/api/v1/lookup"}
    ],
    "timeout_s": 10,
    "retries": 2
  },
  "cache": {"dir": "/cache", "max_mb": 256},
  "map": {
    "tile_servers": [
      {"name": "OpenStreetMap", "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
       "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
       "max_zoom": 19},
      {"name": "OpenTopoMap", "url": "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
       "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors, SRTM | style &copy; <a href=\"https://opentopomap.org\">OpenTopoMap</a> (CC-BY-SA)",
       "max_zoom": 17},
      {"name": "Satellite (Esri)",
       "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
       "attribution": "Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, USDA, USGS, and the GIS User Community",
       "max_zoom": 19},
      {"name": "Satellite (USGS)",
       "url": "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}",
       "attribution": "Imagery: <a href=\"https://www.usgs.gov/programs/national-geospatial-program/national-map\">USGS The National Map</a> (public domain, US only)",
       "max_zoom": 19, "max_native_zoom": 16}
    ],
    "default": "OpenStreetMap"
  },
  "nodes": {
    "feeds": [
      {"name": "K1RKS MeshMap", "url": "https://meshmap.k1rks.me/meshmap/data/nodes.json"}
    ],
    "cache_ttl_s": 300
  },
  "surface": {
    "sources": [
      {"name": "dogami", "label": "Oregon DOGAMI lidar",
       "url": "https://gis.dogami.oregon.gov/arcgis/rest/services/lidar/DIGITAL_SURFACE_MODEL_MOSAIC/ImageServer",
       "units": "ftUS", "bbox": [-124.8, 41.9, -116.4, 46.4]}
    ],
    "spacing_m": 3.0,
    "max_points": 25000,
    "threads": 1,
    "timeout_s": 20,
    "time_budget_s": 30
  }
}
